# Strapi CMS connection — read by src/lib/cms.ts (server-side only, no NEXT_PUBLIC_).
# Copy this file to .env.local (kept out of git) and fill in.
# Local dev: run Strapi in ./cms with `npm run develop` — it serves on :1337.
# When STRAPI_URL is unset, the site serves the static fallback from src/lib/content.ts.
STRAPI_URL=http://localhost:1337

# Strapi API token (admin → Settings → API Tokens). Two uses:
#   1. Read Bearer token — set in production to lock the API down (public `find` is granted by the seed).
#   2. REQUIRED to save store orders — the capture route POSTs to /api/orders with this token
#      (Full access, or a custom token with create permission on Order). Empty = orders won't persist.
STRAPI_API_TOKEN=

# Contact form (src/app/api/contact) — stores the message in Strapi (uses STRAPI_API_TOKEN
# above, needs Create on Contact Message) AND emails a notification via Resend.
#   RESEND_API_KEY — server-only; get at resend.com. Empty = form email disabled (submits fail).
#   RESEND_FROM    — verified sender, e.g. "Bite Size Theology <hello@yourdomain.com>".
#   CONTACT_TO     — where messages are sent; falls back to the Contact page's email address.
#   BOOKING_TO     — where Book Caleb requests go (the pastor's inbox); falls back to CONTACT_TO.
#   PRAYER_TO      — where prayer requests go (the prayer team); falls back to CONTACT_TO.
#                    On the free Resend test-sender this must equal your Resend signup email until
#                    you verify a domain; swap to the pastor's real address once a domain is live.
RESEND_API_KEY=
RESEND_FROM=
CONTACT_TO=
BOOKING_TO=

# Shared secret for the on-demand revalidation route (src/app/api/revalidate).
# Point a Strapi webhook at:  <site-url>/api/revalidate?secret=<this value>
# Only needed in production for instant-on-save updates (dev already fetches fresh).
REVALIDATE_SECRET=

# PayPal (Orders v2) — powers store checkout. Get credentials at
# https://developer.paypal.com/dashboard/ (Apps & Credentials). Use Sandbox creds for testing.
#   NEXT_PUBLIC_PAYPAL_CLIENT_ID — public, inlined into the browser bundle (renders the buttons).
#   PAYPAL_CLIENT_SECRET         — server-only; used to create/capture orders. Never expose it.
#   PAYPAL_ENV                   — "sandbox" (default) or "live".
NEXT_PUBLIC_PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_ENV=sandbox

# Stripe (Checkout, hosted redirect) — the "Pay with card" option at /store/checkout.
# Get a key at https://dashboard.stripe.com/test/apikeys (use a test key for sandbox).
#   STRIPE_SECRET_KEY     — server-only; setting it enables the card button. Never expose it.
#   STRIPE_WEBHOOK_SECRET — optional, only for the deferred checkout.session.completed webhook.
# No publishable key is needed — hosted Checkout redirects to Stripe's page.
STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
