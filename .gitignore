# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# strapi cms (separate app in /cms with its own deps + build output)
/cms/node_modules
/cms/.tmp
/cms/.cache
/cms/.strapi
/cms/build
/cms/dist
/cms/database/*.db

# ide / local tooling
/.idea
/.playwright-mcp

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
