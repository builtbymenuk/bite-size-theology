# Copy to .env next to docker-compose.yml and fill in.  cp .env.docker.example .env
# NEVER commit the real .env (it's gitignored).

# --- Public address the BROWSER uses to reach Strapi (admin + images) --------------------------
# IP-only demo:   http://<server-ip>:1337
# With a domain:  https://cms.yourdomain.com   (front Strapi with a TLS reverse proxy — see DOCKER.md)
STRAPI_PUBLIC_URL=http://YOUR_SERVER_IP:1337

# --- Postgres ----------------------------------------------------------------------------------
DATABASE_NAME=strapi
DATABASE_USERNAME=strapi
DATABASE_PASSWORD=change-me-strong-password

# --- Strapi secrets (generate each: `openssl rand -base64 16`) ---------------------------------
# APP_KEYS is a comma-separated list of 2+ keys.
APP_KEYS=key1==,key2==
API_TOKEN_SALT=change-me
ADMIN_JWT_SECRET=change-me
JWT_SECRET=change-me
TRANSFER_TOKEN_SALT=change-me
ENCRYPTION_KEY=change-me

# --- Website -> Strapi API token (admin -> Settings -> API Tokens, needed to save store orders) -
STRAPI_API_TOKEN=
REVALIDATE_SECRET=change-me
# Content cache in seconds. 0 = always fresh (CMS edits show on one reload — good for demos).
# Leave blank for the 5-minute production default.
STRAPI_REVALIDATE=0

# --- Payments ----------------------------------------------------------------------------------
NEXT_PUBLIC_PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_ENV=sandbox
STRIPE_SECRET_KEY=
